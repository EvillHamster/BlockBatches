{
  "name": "defectbatch",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.cjs",
    "db:init": "node --env-file-if-exists=.env server/init-db.cjs",
    "users:init": "node --env-file-if-exists=.env server/provision-users.cjs",
    "test": "node --test tests/*.test.cjs",
    "benchmark": "node scripts/benchmark.cjs"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "msnodesqlv8": "6.2.2",
    "mssql": "12.8.0"
  }
}
